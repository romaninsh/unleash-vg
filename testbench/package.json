{
  "name": "unleash-testbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive test bench for Unleash-compatible flag service implementations",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite build && node server/main.ts",
    "dev": "node --watch server/main.ts",
    "stress": "node --disable-warning=ExperimentalWarning scripts/stress.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unleash-client": "^6.12.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
