# The `local` profile (application.yaml): copy to .env and set the token.
#   cp .env.example .env
# Everything here points at the composer.yaml stack Vantage starts; nothing in this file is secret
# except SECRET_INTERNAL_TOKEN, which you make up (openssl rand -hex 32).

# SurrealDB (Vantage resolves the compose hostname to the container's published port).
SECRET_SURREAL_URL=cbor://root:root@surrealdb:8000
SURREAL_NS=flags
SURREAL_DB=flags

# The SDK API (service/), on the port compose publishes.
FLAG_SERVICE_URL=http://127.0.0.1:4380

# Bearer token of the SDK API's /internal/features, which the admin reads compiled flags from.
# composer.yaml passes the same value to the flag service as INTERNAL_TOKEN.
SECRET_INTERNAL_TOKEN=replace-with-openssl-rand-hex-32

# A `prod` profile (.env.prod) has the same keys, pointing at your hosted database and SDK API:
#   SECRET_SURREAL_URL=wss://<user>:<password>@<host>/rpc?auth=database
#   SURREAL_NS=<namespace>
#   SURREAL_DB=<database>
#   FLAG_SERVICE_URL=https://<your sdk api>
#   SECRET_INTERNAL_TOKEN=<another random token>
